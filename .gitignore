# VaultCLI / Password Manager — C# / .NET
# Inspired by github/gitignore Dotnet.gitignore and VisualStudio.gitignore.

# Build outputs and temporary files
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
artifacts/
.artifacts/
[Ll]ogs/
*.log
*.binlog

# IDE/editor-specific files
.vs/
.vscode/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates
*.DotSettings.user
*.sln.iml

# Test results and code coverage
[Tt]est[Rr]esults/
*.trx
*.coverage
*.coveragexml
coverage/
coverage*.json
coverage*.xml
coverage*.info

# NuGet-generated packages and temp files
*.nupkg
*.snupkg
packages/
project.lock.json
project.fragment.lock.json

# Local secrets and configuration (do not commit)
.env
.env.*
!.env.example
secrets.json
appsettings.Local.json
appsettings.Development.local.json
*.pfx
*.p12
*.pem
*.key

# Local password vaults, key material and backups
*.vault
*.vault.*
vault.enc
vault.*.enc
*.keyfile
*.recovery
vault-backups/
backups/vault/

# OS/temporary files
.DS_Store
Thumbs.db
Desktop.ini
*~
*.swp
*.tmp
